# Engine Health MLOps - Environment Variables
# 
# This is a template file. Copy to .env for local development.
# DO NOT commit .env files with real secrets to version control!

# ============================================================================
# General Settings
# ============================================================================
ENGINE_HEALTH_ENV=development
ENGINE_HEALTH_DEBUG=false
ENGINE_HEALTH_LOG_LEVEL=INFO

# ============================================================================
# Data Configuration
# ============================================================================
ENGINE_HEALTH_DATA_WINDOW_SIZE=50
ENGINE_HEALTH_DATA_TEST_SIZE=0.2
ENGINE_HEALTH_DATA_RANDOM_STATE=42
ENGINE_HEALTH_DATA_N_SAMPLES=1000
ENGINE_HEALTH_DATA_N_FEATURES=14

# ============================================================================
# Model Configuration - CNN
# ============================================================================
ENGINE_HEALTH_CNN_HIDDEN_CHANNELS=64
ENGINE_HEALTH_CNN_LEARNING_RATE=0.001
ENGINE_HEALTH_CNN_BATCH_SIZE=32
ENGINE_HEALTH_CNN_NUM_EPOCHS=50

# ============================================================================
# Model Configuration - XGBoost
# ============================================================================
ENGINE_HEALTH_XGB_MAX_DEPTH=6
ENGINE_HEALTH_XGB_N_ESTIMATORS=100
ENGINE_HEALTH_XGB_LEARNING_RATE=0.1

# ============================================================================
# Model Paths
# ============================================================================
ENGINE_HEALTH_CNN_MODEL_PATH=models/cnn_model.pth
ENGINE_HEALTH_XGB_MODEL_PATH=models/xgb_model.pkl

# ============================================================================
# MLflow Configuration
# ============================================================================
# Tracking server URI (file, http, https, postgresql, mysql)
MLFLOW_TRACKING_URI=file:./mlruns

# Experiment name
MLFLOW_EXPERIMENT_NAME=Engine Health Prediction Pipeline

# Optional: Artifact storage location
# MLFLOW_ARTIFACT_LOCATION=s3://my-bucket/mlflow-artifacts

# Optional: Model registry URI (if different from tracking URI)
# MLFLOW_REGISTRY_URI=postgresql://user:password@localhost/mlflow

# MLflow Authentication (if using remote server)
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# ============================================================================
# API Configuration
# ============================================================================
ENGINE_HEALTH_API_HOST=0.0.0.0
ENGINE_HEALTH_API_PORT=8000
ENGINE_HEALTH_API_WORKERS=1
ENGINE_HEALTH_API_RELOAD=false
ENGINE_HEALTH_API_LOG_LEVEL=info
ENGINE_HEALTH_API_MAX_BATCH_SIZE=1000

# ============================================================================
# Kubernetes/Production Secrets (managed via K8s secrets or vault)
# ============================================================================
# These should be set via Kubernetes secrets in production
# DB_PASSWORD=
# API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

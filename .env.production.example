# Production Environment Configuration
ENGINE_HEALTH_ENV=production
ENGINE_HEALTH_DEBUG=false
ENGINE_HEALTH_LOG_LEVEL=WARNING

# Data
ENGINE_HEALTH_DATA_WINDOW_SIZE=50
ENGINE_HEALTH_DATA_TEST_SIZE=0.2

# Models - Production paths
ENGINE_HEALTH_CNN_MODEL_PATH=/app/models/cnn_model.pth
ENGINE_HEALTH_XGB_MODEL_PATH=/app/models/xgb_model.pkl

# MLflow - Production server
MLFLOW_TRACKING_URI=https://mlflow.production.example.com
MLFLOW_EXPERIMENT_NAME=Engine Health Prediction Pipeline

# API - Production settings
ENGINE_HEALTH_API_HOST=0.0.0.0
ENGINE_HEALTH_API_PORT=8000
ENGINE_HEALTH_API_WORKERS=4
ENGINE_HEALTH_API_RELOAD=false
ENGINE_HEALTH_API_LOG_LEVEL=warning
ENGINE_HEALTH_API_MAX_BATCH_SIZE=1000
